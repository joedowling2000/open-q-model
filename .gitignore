# Model weights and quantised copies — 95 GB, all re-creatable from the hub
gguf/

# Cloned upstream repos. The harness is vendored only as a patch set
# (patches/), so our changes are reviewable without shipping someone else's repo.
q-evaluation-harness/
kx-skills/

# Harvested corpus: bulky and reproducible from corpus/manifest.jsonl, which
# records repo, path, licence and commit for every file we kept.
corpus/raw/
corpus/kx-docs/
corpus/hf/
**/*.untrimmed

# Run logs: tens of MB of progress bars, no evidentiary value
logs/

# Scratch
**/__pycache__/
*.pyc
*.partial
*.tmp

# Hand-written pipeline fixtures that happened to land in the output file.
# Authored by a frontier model, so forbidden in training by PREREGISTRATION.md;
# kept out of the corpus to make that impossible to get wrong.
corpus/fixture_records_NOT_FOR_TRAINING.jsonl

# Packed training tensors and adapters — reproducible from the corpus + scripts
data/
out/lora-*/

# Q study bank: colleagues' data, carries contributor names, not cleared for
# publication. Hashes are committed (corpus/q_study_v5/SHA256SUMS), the data is not.
corpus/q_study_v5/*
!corpus/q_study_v5/SHA256SUMS
Q_Study_Data_Sanitised*.zip

# Stage A output carries Morgan Stanley's (LeetCode-derived) problem text;
# the summary and hash are committed, the records are not.
corpus/ms_rebuilt.jsonl
corpus/distilled.jsonl
corpus/round2_records.jsonl
corpus/vector_rewrites.jsonl
corpus/generated_problems.jsonl
